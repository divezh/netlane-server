@@ -0,0 +1,242 @@
+use quiche::h3::{self, NameValue};
+use std::collections::HashSet;
+use std::net::Ipv4Addr;
+use std::time::Duration;
+use tokio::net::UdpSocket;
+
+#[allow(dead_code)]
+mod common;
+
+#[tokio::test]
+async fn health_checks_keep_headers_before_fin_when_connection_window_is_full() {
+    terminal_responses_under_backpressure(b"_check", b"200").await;
+}
+
+#[tokio::test]
+async fn failed_connects_keep_headers_before_fin_when_connection_window_is_full() {
+    terminal_responses_under_backpressure(b"127.0.0.1:0", b"502").await;
+}
+
+#[tokio::test]
+async fn udp_replies_wait_for_response_headers_under_backpressure() {
+    common::set_up_logger();
+    let endpoint_address = common::make_endpoint_address();
+    let echo_socket = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+    let echo_address = echo_socket.local_addr().unwrap();
+    let (first_reply_tx, first_reply_rx) = tokio::sync::oneshot::channel();
+    let echo = async move {
+        let mut first_reply_tx = Some(first_reply_tx);
+        loop {
+            let mut buf = [0; 1024];
+            let (n, peer) = echo_socket.recv_from(&mut buf).await.unwrap();
+            echo_socket.send_to(&buf[..n], peer).await.unwrap();
+            if let Some(tx) = first_reply_tx.take() {
+                tx.send(()).unwrap();
+            }
+        }
+    };
+    let client = async {
+        let mut session = common::Http3Session::connect_with_receive_window(
+            &endpoint_address,
+            common::MAIN_DOMAIN_NAME,
+            None,
+            128,
+        )
+        .await;
+        for _ in 0..64 {
+            session
+                .h3_conn
+                .send_request(
+                    &mut session.quic_conn,
+                    &[
+                        h3::Header::new(b":method", b"CONNECT"),
+                        h3::Header::new(b":authority", b"_check"),
+                    ],
+                    true,
+                )
+                .unwrap();
+        }
+        let udp_stream = session
+            .h3_conn
+            .send_request(
+                &mut session.quic_conn,
+                &[
+                    h3::Header::new(b":method", b"CONNECT"),
+                    h3::Header::new(b":authority", b"_udp2"),
+                ],
+                false,
+            )
+            .unwrap();
+        let payload = b"quic-dns";
+        let mut packet = Vec::new();
+        packet.extend_from_slice(&(37 + payload.len() as u32).to_be_bytes());
+        packet.extend_from_slice(&[0; 12]);
+        packet.extend_from_slice(&Ipv4Addr::LOCALHOST.octets());
+        packet.extend_from_slice(&1234u16.to_be_bytes());
+        packet.extend_from_slice(&[0; 12]);
+        packet.extend_from_slice(&Ipv4Addr::LOCALHOST.octets());
+        packet.extend_from_slice(&echo_address.port().to_be_bytes());
+        packet.push(0);
+        packet.extend_from_slice(payload);
+        assert_eq!(
+            session
+                .h3_conn
+                .send_body(&mut session.quic_conn, udp_stream, &packet, false)
+                .unwrap(),
+            packet.len()
+        );
+        common::Http3Session::flush_quic_data(&session.socket, &mut session.quic_conn);
+        first_reply_rx.await.unwrap();
+        tokio::time::sleep(Duration::from_millis(100)).await;
+
+        let mut headers = HashSet::new();
+        let mut finished = HashSet::new();
+        let mut udp_body = Vec::new();
+        while finished.len() < 64 || !udp_body.ends_with(payload) {
+            common::Http3Session::read_out_socket(&session.socket, &mut session.quic_conn);
+            loop {
+                match session.h3_conn.poll(&mut session.quic_conn) {
+                    Ok((id, h3::Event::Headers { list, .. })) => {
+                        assert!(list
+                            .iter()
+                            .any(|h| h.name() == b":status" && h.value() == b"200"));
+                        headers.insert(id);
+                        if id == udp_stream {
+                            session
+                                .h3_conn
+                                .send_body(&mut session.quic_conn, udp_stream, &packet, false)
+                                .unwrap();
+                        }
+                    }
+                    Ok((id, h3::Event::Finished)) => {
+                        assert!(headers.contains(&id));
+                        assert_ne!(
+                            id, udp_stream,
+                            "UDP tunnel was closed while headers were deferred"
+                        );
+                        finished.insert(id);
+                    }
+                    Ok((id, h3::Event::Data)) => {
+                        assert_eq!(id, udp_stream);
+                        assert!(headers.contains(&id));
+                        let mut buf = [0; 1024];
+                        loop {
+                            match session
+                                .h3_conn
+                                .recv_body(&mut session.quic_conn, id, &mut buf)
+                            {
+                                Ok(n) => udp_body.extend_from_slice(&buf[..n]),
+                                Err(h3::Error::Done) => break,
+                                Err(e) => panic!("UDP body read failed: {e}"),
+                            }
+                        }
+                    }
+                    Ok((id, event)) => panic!("unexpected event on stream {id}: {event:?}"),
+                    Err(h3::Error::Done) => break,
+                    Err(e) => panic!("HTTP/3 UDP tunnel failed under backpressure: {e}"),
+                }
+            }
+            assert!(!session.quic_conn.is_closed());
+            assert!(session.quic_conn.peer_error().is_none());
+            common::Http3Session::flush_quic_data(&session.socket, &mut session.quic_conn);
+            let timeout = session
+                .quic_conn
+                .timeout()
+                .unwrap_or(Duration::from_secs(1));
+            let wait = timeout.min(Duration::from_millis(20));
+            if tokio::time::timeout(wait, session.socket.readable())
+                .await
+                .is_err()
+                && wait == timeout
+            {
+                session.quic_conn.on_timeout();
+            }
+        }
+    };
+    tokio::select! {
+        _ = common::run_endpoint(&endpoint_address) => panic!("endpoint stopped"),
+        _ = echo => unreachable!(),
+        _ = client => (),
+        _ = tokio::time::sleep(Duration::from_secs(10)) => panic!("UDP backpressure test timed out"),
+    }
+}
+
+async fn terminal_responses_under_backpressure(authority: &[u8], status: &[u8]) {
+    common::set_up_logger();
+    let endpoint_address = common::make_endpoint_address();
+    let client = async {
+        let mut session = common::Http3Session::connect_with_receive_window(
+            &endpoint_address,
+            common::MAIN_DOMAIN_NAME,
+            None,
+            128,
+        )
+        .await;
+        let request = [
+            h3::Header::new(b":method", b"CONNECT"),
+            h3::Header::new(b":authority", authority),
+        ];
+        let mut requested = HashSet::new();
+        for _ in 0..64 {
+            requested.insert(
+                session
+                    .h3_conn
+                    .send_request(&mut session.quic_conn, &request, true)
+                    .unwrap(),
+            );
+        }
+        common::Http3Session::flush_quic_data(&session.socket, &mut session.quic_conn);
+        // Let replies exhaust the receive window before the client consumes any headers.
+        tokio::time::sleep(Duration::from_millis(200)).await;
+
+        let mut headers = HashSet::new();
+        let mut finished = HashSet::new();
+        while finished.len() < requested.len() {
+            common::Http3Session::read_out_socket(&session.socket, &mut session.quic_conn);
+            loop {
+                match session.h3_conn.poll(&mut session.quic_conn) {
+                    Ok((id, h3::Event::Headers { list, .. })) => {
+                        assert!(requested.contains(&id));
+                        assert!(list
+                            .iter()
+                            .any(|h| h.name() == b":status" && h.value() == status));
+                        headers.insert(id);
+                    }
+                    Ok((id, h3::Event::Finished)) => {
+                        assert!(
+                            headers.contains(&id),
+                            "stream {id} finished before response headers"
+                        );
+                        finished.insert(id);
+                    }
+                    Ok((id, event)) => panic!("unexpected event on stream {id}: {event:?}"),
+                    Err(h3::Error::Done) => break,
+                    Err(e) => panic!("HTTP/3 failed under backpressure: {e}"),
+                }
+            }
+            assert!(!session.quic_conn.is_closed());
+            assert!(session.quic_conn.peer_error().is_none());
+            common::Http3Session::flush_quic_data(&session.socket, &mut session.quic_conn);
+            if finished.len() < requested.len() {
+                let timeout = session
+                    .quic_conn
+                    .timeout()
+                    .unwrap_or(Duration::from_secs(1));
+                let wait = timeout.min(Duration::from_millis(20));
+                if tokio::time::timeout(wait, session.socket.readable())
+                    .await
+                    .is_err()
+                    && wait == timeout
+                {
+                    session.quic_conn.on_timeout();
+                }
+            }
+        }
+        assert_eq!(headers, requested);
+    };
+    tokio::select! {
+        _ = common::run_endpoint(&endpoint_address) => panic!("endpoint stopped"),
+        _ = client => (),
+        _ = tokio::time::sleep(Duration::from_secs(10)) => panic!("backpressure test timed out"),
+    }
+}
