index 0000000..cff56df
--- /dev/null
+++ b/lib/src/usage.rs
@@ -0,0 +1,695 @@
+//! Durable write-ahead credit shared by all transports of an immutable user ID.
+use chrono::{Datelike, Utc};
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeMap;
+use std::fs::{File, OpenOptions};
+use std::io::{self, BufRead, BufReader, Write};
+use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex};
+
+pub const CREDIT_BYTES: u64 = 1024 * 1024;
+const COMPACT_BYTES: u64 = 8 * 1024 * 1024;
+const MAX_BYTES: u64 = 16 * 1024 * 1024;
+
+#[derive(Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct UsageRecord {
+    pub user_id: String,
+    pub month: String,
+    pub reserved_bytes: u64,
+    pub upload_bytes: u64,
+    pub download_bytes: u64,
+}
+#[derive(Serialize)]
+pub struct UsageView {
+    #[serde(flatten)]
+    pub record: UsageRecord,
+    pub charged_bytes: u64,
+    pub in_flight_bytes: u64,
+    pub uncertain_bytes: u64,
+}
+#[derive(Serialize)]
+pub struct UsageSnapshot {
+    pub month: String,
+    pub started_at: String,
+    pub credit_bytes: u64,
+    pub records: Vec<UsageView>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+enum Event {
+    Header {
+        version: u32,
+        month: String,
+        started_at: String,
+    },
+    Month {
+        month: String,
+    },
+    Usage {
+        record: UsageRecord,
+    },
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    data: Event,
+    checksum: String,
+}
+struct Entry {
+    record: UsageRecord,
+    available: u64,
+    in_flight: u64,
+    dirty: bool,
+}
+struct Book {
+    month: String,
+    started_at: String,
+    entries: BTreeMap<(String, String), Entry>,
+    file: File,
+    bytes: u64,
+    broken: bool,
+}
+pub struct UsageLedger {
+    path: PathBuf,
+    _lock: File,
+    book: Mutex<Book>,
+}
+pub(crate) enum Attempt {
+    Granted(Credit),
+    Persist,
+    Exhausted,
+}
+pub(crate) struct Credit {
+    ledger: Arc<UsageLedger>,
+    key: (String, String),
+    pub bytes: usize,
+    upload: bool,
+    settled: bool,
+}
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid usage journal")
+}
+fn valid_month(value: &str) -> bool {
+    value.len() == 7
+        && value.as_bytes()[4] == b'-'
+        && value[..4].bytes().all(|b| b.is_ascii_digit())
+        && value[5..]
+            .parse::<u8>()
+            .is_ok_and(|m| (1..=12).contains(&m))
+}
+fn month_now() -> String {
+    let now = Utc::now();
+    format!("{:04}-{:02}", now.year(), now.month())
+}
+fn cutoff(month: &str) -> String {
+    let n = (month[..4].parse::<u32>().unwrap() * 12 + month[5..].parse::<u32>().unwrap() - 1)
+        .saturating_sub(23);
+    format!("{:04}-{:02}", n / 12, n % 12 + 1)
+}
+fn checksum(event: &Event) -> io::Result<String> {
+    let bytes = serde_json::to_vec(event).map_err(|_| invalid())?;
+    Ok(hex::encode(
+        ring::digest::digest(&ring::digest::SHA256, &bytes).as_ref(),
+    ))
+}
+fn encode(event: Event) -> io::Result<Vec<u8>> {
+    let checksum = checksum(&event)?;
+    let mut line = serde_json::to_vec(&Envelope {
+        data: event,
+        checksum,
+    })
+    .map_err(|_| invalid())?;
+    line.push(b'\n');
+    Ok(line)
+}
+fn open_private(path: &Path, create: bool) -> io::Result<File> {
+    let file = OpenOptions::new()
+        .read(true)
+        .append(true)
+        .create(create)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(path)?;
+    let meta = file.metadata()?;
+    if !meta.is_file() || meta.permissions().mode() & 0o077 != 0 || meta.len() > MAX_BYTES {
+        return Err(invalid());
+    }
+    Ok(file)
+}
+impl UsageLedger {
+    pub fn open(path: &Path, allow_create: bool) -> io::Result<Arc<Self>> {
+        Self::open_at(path, allow_create, &month_now())
+    }
+    fn open_at(path: &Path, allow_create: bool, now: &str) -> io::Result<Arc<Self>> {
+        if !path.is_absolute() {
+            return Err(invalid());
+        }
+        let parent = path.parent().ok_or_else(invalid)?;
+        let meta = std::fs::metadata(parent)?;
+        if !meta.is_dir() || meta.permissions().mode() & 0o027 != 0 {
+            return Err(invalid());
+        }
+        let lock_path = path.with_extension("lock");
+        let lock = open_private(&lock_path, true)?;
+        lock.try_lock().map_err(|_| {
+            io::Error::new(io::ErrorKind::WouldBlock, "usage journal already in use")
+        })?;
+        let file = open_private(path, allow_create)?;
+        let mut book = Book {
+            month: String::new(),
+            started_at: String::new(),
+            entries: BTreeMap::new(),
+            bytes: file.metadata()?.len(),
+            file,
+            broken: false,
+        };
+        if book.bytes == 0 {
+            if !allow_create {
+                return Err(invalid());
+            }
+            book.month = now.into();
+            book.started_at = Utc::now().to_rfc3339();
+            let data = encode(Event::Header {
+                version: 1,
+                month: book.month.clone(),
+                started_at: book.started_at.clone(),
+            })?;
+            book.file.write_all(&data)?;
+            book.file.sync_all()?;
+            File::open(parent)?.sync_all()?;
+            book.bytes = data.len() as u64;
+        } else {
+            for (index, line) in BufReader::new(book.file.try_clone()?)
+                .split(b'\n')
+                .enumerate()
+            {
+                let line = line?;
+                if line.is_empty() {
+                    return Err(invalid());
+                }
+                let event: Envelope = serde_json::from_slice(&line).map_err(|_| invalid())?;
+                if checksum(&event.data)? != event.checksum {
+                    return Err(invalid());
+                }
+                match event.data {
+                    Event::Header {
+                        version,
+                        month,
+                        started_at,
+                    } if index == 0
+                        && version == 1
+                        && valid_month(&month)
+                        && chrono::DateTime::parse_from_rfc3339(&started_at).is_ok() =>
+                    {
+                        book.month = month;
+                        book.started_at = started_at;
+                    }
+                    Event::Month { month }
+                        if index > 0 && valid_month(&month) && month > book.month =>
+                    {
+                        let oldest = cutoff(&month);
+                        book.entries.retain(|(m, _), _| m >= &oldest);
+                        book.month = month;
+                    }
+                    Event::Usage { record } if index > 0 => {
+                        if record.user_id.is_empty()
+                            || record.user_id.len() > 128
+                            || !valid_month(&record.month)
+                            || record.month > book.month
+                            || record
+                                .upload_bytes
+                                .checked_add(record.download_bytes)
+                                .is_none_or(|n| n > record.reserved_bytes)
+                        {
+                            return Err(invalid());
+                        }
+                        let key = (record.month.clone(), record.user_id.clone());
+                        if record.month >= cutoff(&book.month) {
+                            book.entries.insert(
+                                key,
+                                Entry {
+                                    record,
+                                    available: 0,
+                                    in_flight: 0,
+                                    dirty: false,
+                                },
+                            );
+                        }
+                    }
+                    _ => return Err(invalid()),
+                }
+            }
+            use std::io::{Read, Seek, SeekFrom};
+            let mut check = book.file.try_clone()?;
+            check.seek(SeekFrom::End(-1))?;
+            let mut end = [0];
+            check.read_exact(&mut end)?;
+            if end[0] != b'\n' {
+                return Err(invalid());
+            }
+        }
+        if book.month.as_str() > now {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "UTC month moved backwards",
+            ));
+        }
+        Ok(Arc::new(Self {
+            path: path.into(),
+            _lock: lock,
+            book: Mutex::new(book),
+        }))
+    }
+    fn compact(&self, book: &mut Book) -> io::Result<()> {
+        let parent = self.path.parent().ok_or_else(invalid)?;
+        let mut tmp = tempfile::NamedTempFile::new_in(parent)?;
+        tmp.write_all(&encode(Event::Header {
+            version: 1,
+            month: book.month.clone(),
+            started_at: book.started_at.clone(),
+        })?)?;
+        for entry in book.entries.values() {
+            tmp.write_all(&encode(Event::Usage {
+                record: entry.record.clone(),
+            })?)?;
+        }
+        tmp.as_file().sync_all()?;
+        tmp.persist(&self.path).map_err(|e| e.error)?;
+        File::open(parent)?.sync_all()?;
+        book.file = open_private(&self.path, false)?;
+        book.bytes = book.file.metadata()?.len();
+        Ok(())
+    }
+    fn append(&self, book: &mut Book, event: Event) -> io::Result<()> {
+        let result = (|| {
+            let line = encode(event)?;
+            book.file.write_all(&line)?;
+            book.file.sync_data()?;
+            book.bytes += line.len() as u64;
+            if book.bytes >= COMPACT_BYTES {
+                self.compact(book)?;
+            }
+            Ok(())
+        })();
+        if result.is_err() {
+            book.broken = true;
+        }
+        result
+    }
+    fn healthy(book: &Book, month: &str) -> io::Result<()> {
+        if book.broken || month < book.month.as_str() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "usage journal unavailable",
+            ));
+        }
+        Ok(())
+    }
+    fn remaining(entry: &Entry, limit: u64) -> u64 {
+        if limit == 0 {
+            u64::MAX - entry.record.reserved_bytes + entry.available
+        } else {
+            limit.saturating_sub(entry.record.reserved_bytes - entry.available)
+        }
+    }
+    pub fn allowed(&self, user: &str, limit: u64) -> bool {
+        let month = month_now();
+        let book = self.book.lock().unwrap();
+        if Self::healthy(&book, &month).is_err() {
+            return false;
+        }
+        book.entries
+            .get(&(month, user.into()))
+            .is_none_or(|e| Self::remaining(e, limit) > 0 || e.in_flight > 0)
+    }
+    pub(crate) fn try_credit(
+        self: &Arc<Self>,
+        user: &str,
+        limit: u64,
+        requested: usize,
+        upload: bool,
+        whole: bool,
+    ) -> io::Result<Attempt> {
+        self.try_credit_at(user, limit, requested, upload, whole, &month_now())
+    }
+    fn try_credit_at(
+        self: &Arc<Self>,
+        user: &str,
+        limit: u64,
+        requested: usize,
+        upload: bool,
+        whole: bool,
+        month: &str,
+    ) -> io::Result<Attempt> {
+        let mut book = self.book.lock().unwrap();
+        Self::healthy(&book, month)?;
+        if month > book.month.as_str() {
+            return Ok(Attempt::Persist);
+        }
+        let key = (month.into(), user.into());
+        let Some(entry) = book.entries.get_mut(&key) else {
+            return Ok(Attempt::Persist);
+        };
+        let remaining = Self::remaining(entry, limit);
+        if remaining == 0 || whole && remaining < requested as u64 {
+            return Ok(Attempt::Exhausted);
+        }
+        if requested > 0 && (entry.available == 0 || whole && entry.available < requested as u64) {
+            return Ok(Attempt::Persist);
+        }
+        let n = (requested as u64).min(entry.available).min(remaining);
+        entry.available -= n;
+        entry.in_flight += n;
+        Ok(Attempt::Granted(Credit {
+            ledger: self.clone(),
+            key,
+            bytes: n as usize,
+            upload,
+            settled: false,
+        }))
+    }
+    pub(crate) fn refill(&self, user: &str, limit: u64) -> io::Result<()> {
+        self.refill_at(user, limit, &month_now())
+    }
+    fn refill_at(&self, user: &str, limit: u64, month: &str) -> io::Result<()> {
+        let mut book = self.book.lock().unwrap();
+        Self::healthy(&book, month)?;
+        if month > book.month.as_str() {
+            let oldest = cutoff(month);
+            book.entries
+                .retain(|(m, _), e| m >= &oldest || e.in_flight > 0);
+            book.month = month.into();
+            self.append(
+                &mut book,
+                Event::Month {
+                    month: month.into(),
+                },
+            )?;
+        }
+        let key = (month.into(), user.into());
+        let entry = book.entries.entry(key.clone()).or_insert_with(|| Entry {
+            record: UsageRecord {
+                user_id: user.into(),
+                month: month.into(),
+                ..Default::default()
+            },
+            available: 0,
+            in_flight: 0,
+            dirty: false,
+        });
+        let credit = CREDIT_BYTES.saturating_sub(entry.available);
+        let amount = if limit == 0 {
+            credit
+        } else {
+            limit
+                .saturating_sub(entry.record.reserved_bytes)
+                .min(credit)
+        };
+        if amount == 0 {
+            return Ok(());
+        }
+        entry.record.reserved_bytes = entry
+            .record
+            .reserved_bytes
+            .checked_add(amount)
+            .ok_or_else(invalid)?;
+        entry.available += amount;
+        let record = entry.record.clone();
+        self.append(&mut book, Event::Usage { record })?;
+        book.entries.get_mut(&key).unwrap().dirty = false;
+        Ok(())
+    }
+    pub fn checkpoint(&self) -> io::Result<()> {
+        let mut book = self.book.lock().unwrap();
+        Self::healthy(&book, &month_now())?;
+        let keys: Vec<_> = book
+            .entries
+            .iter()
+            .filter(|(_, e)| e.available > 0 || e.dirty)
+            .map(|(k, _)| k.clone())
+            .collect();
+        for key in keys {
+            let e = book.entries.get_mut(&key).unwrap();
+            e.record.reserved_bytes -= e.available;
+            e.available = 0;
+            e.dirty = false;
+            let record = e.record.clone();
+            self.append(&mut book, Event::Usage { record })?;
+        }
+        Ok(())
+    }
+    pub fn snapshot(&self) -> io::Result<UsageSnapshot> {
+        let month = month_now();
+        let book = self.book.lock().unwrap();
+        Self::healthy(&book, &month)?;
+        Ok(UsageSnapshot {
+            month,
+            started_at: book.started_at.clone(),
+            credit_bytes: CREDIT_BYTES,
+            records: book
+                .entries
+                .values()
+                .map(|e| {
+                    let charged = e.record.reserved_bytes - e.available - e.in_flight;
+                    UsageView {
+                        record: e.record.clone(),
+                        charged_bytes: charged,
+                        in_flight_bytes: e.in_flight,
+                        uncertain_bytes: charged - e.record.upload_bytes - e.record.download_bytes,
+                    }
+                })
+                .collect(),
+        })
+    }
+}
+impl Credit {
+    pub fn commit(mut self, sent: usize) {
+        assert!(sent <= self.bytes);
+        self.finish(sent);
+        self.settled = true;
+    }
+    fn finish(&mut self, sent: usize) {
+        let mut book = self.ledger.book.lock().unwrap();
+        let entry = book.entries.get_mut(&self.key).unwrap();
+        entry.in_flight -= self.bytes as u64;
+        entry.available += (self.bytes - sent) as u64;
+        entry.dirty |= sent > 0;
+        if self.upload {
+            entry.record.upload_bytes += sent as u64;
+        } else {
+            entry.record.download_bytes += sent as u64;
+        }
+    }
+}
+impl Drop for Credit {
+    fn drop(&mut self) {
+        if !self.settled {
+            self.finish(0);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn open(dir: &tempfile::TempDir) -> Arc<UsageLedger> {
+        std::fs::set_permissions(dir.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+        UsageLedger::open_at(&dir.path().join("usage.jsonl"), true, "2026-01").unwrap()
+    }
+    fn grant(
+        book: &Arc<UsageLedger>,
+        limit: u64,
+        n: usize,
+        upload: bool,
+        whole: bool,
+    ) -> Option<Credit> {
+        loop {
+            match book
+                .try_credit_at("alice", limit, n, upload, whole, "2026-01")
+                .unwrap()
+            {
+                Attempt::Granted(c) => return Some(c),
+                Attempt::Exhausted => return None,
+                Attempt::Persist => book.refill_at("alice", limit, "2026-01").unwrap(),
+            }
+        }
+    }
+    #[test]
+    fn directions_and_parallel_reservations_share_one_budget() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        let a = grant(&book, 100, 60, true, false).unwrap();
+        let b = grant(&book, 100, 60, false, false).unwrap();
+        assert_eq!(b.bytes, 40);
+        assert!(grant(&book, 100, 1, true, false).is_none());
+        a.commit(50);
+        b.commit(40);
+        let c = grant(&book, 100, 100, false, false).unwrap();
+        assert_eq!(c.bytes, 10);
+        c.commit(10);
+        assert!(grant(&book, 100, 1, true, false).is_none());
+        let view = book.snapshot().unwrap();
+        assert_eq!(view.records[0].charged_bytes, 100);
+        assert_eq!(view.records[0].record.upload_bytes, 50);
+        assert_eq!(view.records[0].record.download_bytes, 50);
+    }
+    #[test]
+    fn concurrent_threads_cannot_multiply_credit() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        let workers: Vec<_> = (0..24)
+            .map(|_| {
+                let book = book.clone();
+                std::thread::spawn(move || {
+                    let mut sum = 0;
+                    while let Some(c) = grant(&book, 100000, 16384, false, false) {
+                        let n = c.bytes;
+                        sum += n;
+                        c.commit(n);
+                    }
+                    sum
+                })
+            })
+            .collect();
+        let sent: usize = workers.into_iter().map(|w| w.join().unwrap()).sum();
+        assert_eq!(sent, 100000);
+        assert_eq!(book.snapshot().unwrap().records[0].charged_bytes, 100000);
+    }
+    #[test]
+    fn cancelled_writes_and_whole_datagrams_do_not_lose_budget() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        drop(grant(&book, 100, 90, false, false).unwrap());
+        assert!(grant(&book, 100, 101, true, true).is_none());
+        grant(&book, 100, 100, false, true).unwrap().commit(100);
+        assert!(grant(&book, 100, 1, false, false).is_none());
+    }
+    #[test]
+    fn restart_forfeits_only_the_bounded_unused_credit() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 2 * CREDIT_BYTES, 100, false, false)
+            .unwrap()
+            .commit(100);
+        assert_eq!(book.snapshot().unwrap().records[0].charged_bytes, 100);
+        drop(book);
+        let book = open(&dir);
+        let view = book.snapshot().unwrap();
+        assert_eq!(view.records[0].charged_bytes, CREDIT_BYTES);
+        assert_eq!(view.records[0].uncertain_bytes, CREDIT_BYTES);
+        grant(&book, 2 * CREDIT_BYTES, CREDIT_BYTES as usize, true, false)
+            .unwrap()
+            .commit(CREDIT_BYTES as usize);
+        assert!(grant(&book, 2 * CREDIT_BYTES, 1, true, false).is_none());
+    }
+    #[test]
+    fn checkpoint_makes_idle_usage_exact_and_keeps_inflight_credit() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 1000, 100, true, false).unwrap().commit(100);
+        let pending = grant(&book, 1000, 50, false, false).unwrap();
+        book.checkpoint().unwrap();
+        pending.commit(30);
+        book.checkpoint().unwrap();
+        drop(book);
+        let book = open(&dir);
+        let v = book.snapshot().unwrap();
+        assert_eq!(v.records[0].charged_bytes, 130);
+        assert_eq!(v.records[0].uncertain_bytes, 0);
+    }
+    #[test]
+    fn checkpoint_preserves_direction_totals_when_quota_is_exactly_exhausted() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 100, 100, true, false).unwrap().commit(100);
+        book.checkpoint().unwrap();
+        drop(book);
+        let book = open(&dir);
+        let snapshot = book.snapshot().unwrap();
+        assert_eq!(snapshot.records[0].record.upload_bytes, 100);
+        assert_eq!(snapshot.records[0].uncertain_bytes, 0);
+    }
+    #[test]
+    fn changing_limit_does_not_reset_spending() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 0, 80, true, false).unwrap().commit(80);
+        assert!(grant(&book, 50, 1, false, false).is_none());
+        let c = grant(&book, 100, 40, false, false).unwrap();
+        assert_eq!(c.bytes, 20);
+        c.commit(20);
+        assert!(grant(&book, 100, 1, false, false).is_none());
+        grant(&book, 200, 10, false, false).unwrap().commit(10);
+        assert_eq!(book.snapshot().unwrap().records[0].charged_bytes, 110);
+    }
+    #[test]
+    fn month_rollover_retains_history_and_refuses_clock_rollback() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 100, 100, false, false).unwrap().commit(100);
+        book.refill_at("alice", 100, "2026-02").unwrap();
+        let Attempt::Granted(c) = book
+            .try_credit_at("alice", 100, 100, true, false, "2026-02")
+            .unwrap()
+        else {
+            panic!("new month has no credit")
+        };
+        c.commit(100);
+        assert!(book
+            .try_credit_at("alice", 100, 1, false, false, "2026-01")
+            .is_err());
+        assert_eq!(book.snapshot().unwrap().records.len(), 2);
+        drop(book);
+        assert!(UsageLedger::open_at(&dir.path().join("usage.jsonl"), false, "2026-01").is_err());
+        let book = UsageLedger::open_at(&dir.path().join("usage.jsonl"), false, "2026-02").unwrap();
+        assert_eq!(book.snapshot().unwrap().records.len(), 2);
+    }
+    #[test]
+    fn missing_torn_corrupt_or_insecure_journals_fail_closed() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("usage.jsonl");
+        assert!(UsageLedger::open(&path, false).is_err());
+        let book = open(&dir);
+        assert!(UsageLedger::open(&path, true).is_err());
+        drop(book);
+        let bytes = std::fs::read(&path).unwrap();
+        std::fs::write(&path, &bytes[..bytes.len() - 1]).unwrap();
+        assert!(UsageLedger::open(&path, true).is_err());
+        std::fs::write(&path, b"{corrupt}\n").unwrap();
+        assert!(UsageLedger::open(&path, true).is_err());
+        std::fs::write(&path, &bytes).unwrap();
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(UsageLedger::open(&path, true).is_err());
+    }
+    #[test]
+    fn storage_failure_revokes_future_credit() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        book.book.lock().unwrap().file = File::open(dir.path().join("usage.jsonl")).unwrap();
+        assert!(book.refill_at("alice", 100, "2026-01").is_err());
+        assert!(book.snapshot().is_err());
+        assert!(!book.allowed("alice", 0));
+        assert!(book
+            .try_credit_at("alice", 100, 1, false, false, "2026-01")
+            .is_err());
+    }
+    #[test]
+    fn compaction_replays_the_same_usage_and_retention_is_bounded() {
+        let dir = tempfile::tempdir().unwrap();
+        let book = open(&dir);
+        grant(&book, 100, 50, true, false).unwrap().commit(50);
+        book.checkpoint().unwrap();
+        {
+            let mut inner = book.book.lock().unwrap();
+            inner.bytes = COMPACT_BYTES;
+        }
+        book.refill_at("alice", 100, "2026-01").unwrap();
+        drop(book);
+        let book = open(&dir);
+        assert_eq!(book.snapshot().unwrap().records[0].charged_bytes, 100);
+        book.refill_at("alice", 100, "2028-01").unwrap();
+        assert_eq!(book.book.lock().unwrap().entries.len(), 1);
+    }
+}
