+async fn shared_quota(h3: bool) {
+    use std::os::unix::fs::PermissionsExt;
+    let dir = tempfile::tempdir().unwrap();
+    std::fs::set_permissions(dir.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+    let ledger =
+        trusttunnel::usage::UsageLedger::open(&dir.path().join("usage.jsonl"), true).unwrap();
+    let quota = 65536;
+    let (endpoint, cert, core) = make_endpoint_with_usage(Some(ledger.clone()), quota);
+    let server = tokio::spawn({
+        let core = core.clone();
+        async move { core.listen().await.unwrap() }
+    });
+    let origin = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+    let target = origin.local_addr().unwrap();
+    let peer = tokio::spawn(async move {
+        let mut peers = Vec::new();
+        for _ in 0..3 {
+            peers.push(origin.accept().await.unwrap().0);
+        }
+        for mut stream in peers {
+            tokio::spawn(async move {
+                let _ = stream.write_all(&vec![42; 262144]).await;
+            });
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    let work = async {
+        let (a, b, bob) = tokio::join!(
+            Box::pin(transfer(h3, endpoint, target, "alice", false)),
+            Box::pin(transfer(h3, endpoint, target, "alice", false)),
+            Box::pin(transfer(h3, endpoint, target, "bob", false))
+        );
+        assert!(
+            a + b <= quota as usize,
+            "parallel transports bypassed quota"
+        );
+        assert!(a + b > 0);
+        assert_eq!(bob, 262144);
+        let snapshot = ledger.snapshot().unwrap();
+        let usage = snapshot
+            .records
+            .iter()
+            .find(|r| r.record.user_id == "alice")
+            .unwrap();
+        assert_eq!(usage.charged_bytes, quota);
+        assert!(!ledger.allowed("alice", quota));
+    };
+    tokio::time::timeout(Duration::from_secs(8), Box::pin(work))
+        .await
+        .unwrap();
+    server.abort();
+    peer.abort();
+    drop(cert);
+}
+#[tokio::test]
+async fn h2_parallel_transports_share_durable_quota() {
+    Box::pin(shared_quota(false)).await;
+}
+#[tokio::test]
+async fn h3_parallel_transports_share_durable_quota() {
+    Box::pin(shared_quota(true)).await;
