+fn configure_udp_buffers(socket: &UdpSocket) {
+    let socket = SockRef::from(socket);
+    if socket
+        .recv_buffer_size()
+        .is_ok_and(|n| n < QUIC_UDP_BUFFER_SIZE)
+    {
+        if let Err(e) = socket.set_recv_buffer_size(QUIC_UDP_BUFFER_SIZE) {
+            log::warn!("Could not enlarge QUIC UDP receive buffer: {}", e);
+        }
+    }
+    if socket
+        .send_buffer_size()
+        .is_ok_and(|n| n < QUIC_UDP_BUFFER_SIZE)
+    {
+        if let Err(e) = socket.set_send_buffer_size(QUIC_UDP_BUFFER_SIZE) {
+            log::warn!("Could not enlarge QUIC UDP send buffer: {}", e);
+        }
+    }
+    match (socket.recv_buffer_size(), socket.send_buffer_size()) {
+        (Ok(receive), Ok(send)) => log::info!(
+            "QUIC UDP socket buffers: receive={} send={} bytes (request={} per direction; kernel limits apply)",
+            receive, send, QUIC_UDP_BUFFER_SIZE
+        ),
+        _ => log::warn!("Could not read effective QUIC UDP socket buffer sizes"),
+    }
+}
