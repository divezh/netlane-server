+#[cfg(test)]
+mod buffer_tests {
+    use super::*;
+    use std::net::Ipv4Addr;
+
+    #[tokio::test]
+    async fn expands_udp_queues_and_keeps_socket_usable() {
+        let socket = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        let reference = SockRef::from(&socket);
+        reference.set_recv_buffer_size(4096).unwrap();
+        reference.set_send_buffer_size(4096).unwrap();
+        let before = (
+            reference.recv_buffer_size().unwrap(),
+            reference.send_buffer_size().unwrap(),
+        );
+
+        configure_udp_buffers(&socket);
+
+        assert!(reference.recv_buffer_size().unwrap() > before.0);
+        assert!(reference.send_buffer_size().unwrap() > before.1);
+        let peer = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        peer.send_to(b"quic-buffer-check", socket.local_addr().unwrap())
+            .await
+            .unwrap();
+        let mut buf = [0; 64];
+        let (n, _) = tokio::time::timeout(Duration::from_secs(1), socket.recv_from(&mut buf))
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(&buf[..n], b"quic-buffer-check");
+    }
+
+    #[tokio::test]
+    async fn keeps_effective_buffers_on_repeated_configuration() {
+        let socket = UdpSocket::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+        configure_udp_buffers(&socket);
+        let reference = SockRef::from(&socket);
+        let first = (
+            reference.recv_buffer_size().unwrap(),
+            reference.send_buffer_size().unwrap(),
+        );
+
+        configure_udp_buffers(&socket);
+
+        assert_eq!(reference.recv_buffer_size().unwrap(), first.0);
+        assert_eq!(reference.send_buffer_size().unwrap(), first.1);
+    }
+}
