+async fn udp_expiry(h3: bool) {
+    use bytes::BufMut;
+    let (endpoint, cert, core) = make_endpoint();
+    let server = tokio::spawn({
+        let core = core.clone();
+        async move { core.listen().await.unwrap() }
+    });
+    let origin = tokio::net::UdpSocket::bind((Ipv4Addr::LOCALHOST, 0))
+        .await
+        .unwrap();
+    let target = origin.local_addr().unwrap();
+    let origin_task = tokio::spawn(async move {
+        let mut b = [0u8; 512];
+        loop {
+            let (n, peer) = origin.recv_from(&mut b).await.unwrap();
+            origin.send_to(&b[..n], peer).await.unwrap();
+        }
+    });
+    let mut packet = Vec::new();
+    packet.put_u32(39);
+    packet.extend_from_slice(&[0; 12]);
+    packet.extend_from_slice(&Ipv4Addr::LOCALHOST.octets());
+    packet.put_u16(1234);
+    packet.extend_from_slice(&[0; 12]);
+    packet.extend_from_slice(&Ipv4Addr::LOCALHOST.octets());
+    packet.put_u16(target.port());
+    packet.put_u8(0);
+    packet.extend_from_slice(b"ok");
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    let work = async {
+        if h3 {
+            let mut alice = common::Http3Session::connect(&endpoint, "localhost", None).await;
+            alice.send_request(connect_request("_udp2", "alice")).await;
+            assert_eq!(
+                alice
+                    .recv_response_with_method(&http::Method::CONNECT)
+                    .await
+                    .status,
+                http::StatusCode::OK
+            );
+            alice.send(futures::stream::iter([packet])).await;
+            let mut received = Vec::new();
+            let mut chunk = [0u8; 512];
+            while received.len() < 42 {
+                let n = alice.recv(&mut chunk).await;
+                assert!(n > 0);
+                received.extend_from_slice(&chunk[..n]);
+            }
+            assert!(received.ends_with(b"ok"));
+            close_alice(&core, true);
+            tokio::time::timeout(Duration::from_secs(3), alice.wait_for_peer_close())
+                .await
+                .unwrap();
+        } else {
+            let (_client, mut alice, driver) = h2_echo(endpoint, "_udp2", "alice").await;
+            alice.write_all(&packet).await.unwrap();
+            let mut ack = [0u8; 42];
+            alice.read_exact(&mut ack).await.unwrap();
+            assert!(ack.ends_with(b"ok"));
+            close_alice(&core, true);
+            let result = tokio::time::timeout(Duration::from_secs(3), alice.read(&mut ack))
+                .await
+                .unwrap();
+            assert!(result.is_err() || result.unwrap() == 0);
+            driver.abort();
+        }
+    };
+    tokio::time::timeout(Duration::from_secs(5), Box::pin(work))
+        .await
+        .unwrap();
