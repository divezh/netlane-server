diff --git a/lib/src/p2p_filter.rs b/lib/src/p2p_filter.rs
new file mode 100644
index 0000000..2212afb
--- /dev/null
+++ b/lib/src/p2p_filter.rs
@@ -0,0 +1,165 @@
+//! BitTorrent blocking (Netlane). Tunneled traffic of VPN users is checked for the plain BitTorrent
+//! peer handshake, HTTP tracker announces, UDP tracker requests and DHT (KRPC) messages. A TCP stream
+//! that starts like that is closed; such a UDP datagram is dropped. Encrypted peer connections (MSE)
+//! cannot be told apart from other encrypted traffic and pass; without trackers and DHT they rarely
+//! find peers. The switch is global and set by the management socket (`policy`).
+
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static ENABLED: AtomicBool = AtomicBool::new(true);
+static BLOCKED_STREAMS: AtomicU64 = AtomicU64::new(0);
+static BLOCKED_DATAGRAMS: AtomicU64 = AtomicU64::new(0);
+
+/// How many first bytes of a TCP stream are looked at, at most.
+pub const STREAM_WINDOW: usize = 2048;
+
+pub fn set_enabled(on: bool) {
+    ENABLED.store(on, Ordering::Relaxed);
+}
+
+pub fn enabled() -> bool {
+    ENABLED.load(Ordering::Relaxed)
+}
+
+/// (closed TCP streams, dropped UDP datagrams) since the endpoint started.
+pub fn blocked() -> (u64, u64) {
+    (
+        BLOCKED_STREAMS.load(Ordering::Relaxed),
+        BLOCKED_DATAGRAMS.load(Ordering::Relaxed),
+    )
+}
+
+pub(crate) fn count_stream() {
+    BLOCKED_STREAMS.fetch_add(1, Ordering::Relaxed);
+}
+
+pub(crate) fn count_datagram() {
+    BLOCKED_DATAGRAMS.fetch_add(1, Ordering::Relaxed);
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum Verdict {
+    BitTorrent,
+    Other,
+    NeedMore,
+}
+
+const HANDSHAKE: &[u8] = b"\x13BitTorrent protocol";
+
+/// Looks at the first bytes a client sends on a TCP stream.
+pub(crate) fn inspect_stream(prefix: &[u8]) -> Verdict {
+    if prefix.is_empty() {
+        return Verdict::NeedMore;
+    }
+    // Peer wire protocol: <19>"BitTorrent protocol".
+    if prefix[0] == HANDSHAKE[0] {
+        let n = prefix.len().min(HANDSHAKE.len());
+        if prefix[..n] != HANDSHAKE[..n] {
+            return Verdict::Other;
+        }
+        return if n == HANDSHAKE.len() {
+            Verdict::BitTorrent
+        } else {
+            Verdict::NeedMore
+        };
+    }
+    // HTTP tracker: GET /announce?info_hash=… or /scrape?info_hash=…
+    const GET: &[u8] = b"GET ";
+    let n = prefix.len().min(GET.len());
+    if prefix[..n] != GET[..n] {
+        return Verdict::Other;
+    }
+    let line_end = prefix.windows(2).position(|w| w == b"\r\n");
+    let line = match line_end {
+        Some(end) => &prefix[..end],
+        None if prefix.len() < STREAM_WINDOW => return Verdict::NeedMore,
+        None => prefix,
+    };
+    let lower: Vec<u8> = line.iter().map(u8::to_ascii_lowercase).collect();
+    let has = |needle: &[u8]| lower.windows(needle.len()).any(|w| w == needle);
+    if has(b"info_hash=") && (has(b"announce") || has(b"scrape")) {
+        Verdict::BitTorrent
+    } else {
+        Verdict::Other
+    }
+}
+
+/// UDP tracker protocol (BEP 15): connect request with the magic protocol id.
+const UDP_TRACKER_MAGIC: [u8; 8] = [0x00, 0x00, 0x04, 0x17, 0x27, 0x10, 0x19, 0x80];
+
+/// True for a datagram of the BitTorrent DHT or a UDP tracker request.
+pub(crate) fn inspect_datagram(payload: &[u8]) -> bool {
+    if payload.len() >= 16 && payload[..8] == UDP_TRACKER_MAGIC && payload[8..12] == [0, 0, 0, 0] {
+        return true;
+    }
+    // KRPC (BEP 5) is a bencoded dictionary with a message type and a 20-byte node id:
+    // d1:ad2:id20:…e1:q4:ping1:t2:aa1:y1:qe
+    if payload.len() >= 20
+        && payload.len() <= 2048
+        && payload[0] == b'd'
+        && payload.last() == Some(&b'e')
+    {
+        let has = |needle: &[u8]| payload.windows(needle.len()).any(|w| w == needle);
+        return has(b"1:y1:") && has(b"2:id20:");
+    }
+    false
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn peer_handshake() {
+        let mut hello = HANDSHAKE.to_vec();
+        hello.extend_from_slice(&[0; 8]);
+        assert_eq!(inspect_stream(&hello), Verdict::BitTorrent);
+        assert_eq!(inspect_stream(&HANDSHAKE[..5]), Verdict::NeedMore);
+        assert_eq!(inspect_stream(b"\x13Some other protocol"), Verdict::Other);
+    }
+
+    #[test]
+    fn http_tracker() {
+        assert_eq!(
+            inspect_stream(b"GET /announce?info_hash=%12%34&peer_id=-qB4650-&port=6881 HTTP/1.1\r\nHost: t.example\r\n\r\n"),
+            Verdict::BitTorrent
+        );
+        assert_eq!(
+            inspect_stream(b"GET /scrape.php?INFO_HASH=abc HTTP/1.0\r\n"),
+            Verdict::BitTorrent
+        );
+        assert_eq!(inspect_stream(b"GET /announce?info_ha"), Verdict::NeedMore);
+        assert_eq!(
+            inspect_stream(b"GET /news/announce HTTP/1.1\r\nHost: example.com\r\n\r\n"),
+            Verdict::Other
+        );
+        assert_eq!(
+            inspect_stream(b"POST /announce?info_hash=1"),
+            Verdict::Other
+        );
+        assert_eq!(inspect_stream(b"\x16\x03\x01\x02\x00"), Verdict::Other);
+        assert_eq!(inspect_stream(b"SSH-2.0-OpenSSH_9.6"), Verdict::Other);
+    }
+
+    #[test]
+    fn dht_and_udp_tracker() {
+        assert!(inspect_datagram(
+            b"d1:ad2:id20:abcdefghij0123456789e1:q4:ping1:t2:aa1:y1:qe"
+        ));
+        assert!(inspect_datagram(
+            b"d1:rd2:id20:mnopqrstuvwxyz123456e1:t2:aa1:y1:re"
+        ));
+        let mut connect = UDP_TRACKER_MAGIC.to_vec();
+        connect.extend_from_slice(&[0, 0, 0, 0, 1, 2, 3, 4]);
+        assert!(inspect_datagram(&connect));
+        // DNS, QUIC and plain bencode-looking text are not blocked.
+        assert!(!inspect_datagram(&[
+            0x12, 0x34, 0x01, 0x00, 0x00, 0x01, 0, 0, 0, 0, 0, 0, 7, b'e', b'x', b'a', b'm', b'p',
+            b'l', b'e', 3, b'c', b'o', b'm', 0, 0, 1, 0, 1
+        ]));
+        assert!(!inspect_datagram(&[
+            0xc3, 0, 0, 0, 1, 8, 1, 2, 3, 4, 5, 6, 7, 8, 0, 0x44, 0xd0, 1, 2, 3, 4, 5
+        ]));
+        assert!(!inspect_datagram(b"d4:name5:hello4:size3:abce"));
+    }
+}
