index 0000000..3d254b9
--- /dev/null
+++ b/lib/src/traffic_control.rs
@@ -0,0 +1,338 @@
+//! Shared per-user pacing and cancellation for the managed endpoint.
+use crate::pipe::SimplexDirection;
+use serde::{Deserialize, Serialize};
+use std::collections::HashMap;
+use std::io;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, RwLock, Weak};
+use tokio::sync::watch;
+use tokio::time::{Duration, Instant};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TrafficPolicy {
+    pub username: String,
+    pub enabled: bool,
+    pub download_mbps: u32,
+    pub upload_mbps: u32,
+}
+
+struct Bucket {
+    rate: u64,
+    tokens: f64,
+    at: Instant,
+}
+impl Bucket {
+    fn capacity(rate: u64) -> f64 {
+        (rate / 10).max(65536) as f64
+    }
+    fn new(mbps: u32) -> Self {
+        let rate = u64::from(mbps) * 125000;
+        Self {
+            rate,
+            tokens: Self::capacity(rate),
+            at: Instant::now(),
+        }
+    }
+    fn refill(&mut self) {
+        let now = Instant::now();
+        self.tokens = (self.tokens + now.duration_since(self.at).as_secs_f64() * self.rate as f64)
+            .min(Self::capacity(self.rate));
+        self.at = now;
+    }
+    fn update(&mut self, mbps: u32) {
+        self.refill();
+        self.rate = u64::from(mbps) * 125000;
+        self.tokens = self.tokens.min(Self::capacity(self.rate));
+    }
+}
+
+pub(crate) struct UserControl {
+    enabled: AtomicBool,
+    download: Mutex<Bucket>,
+    upload: Mutex<Bucket>,
+    changed: watch::Sender<u64>,
+}
+impl UserControl {
+    pub(crate) fn refund(&self, direction: SimplexDirection, bytes: usize) {
+        let mut b = match direction {
+            SimplexDirection::Incoming => self.download.lock().unwrap(),
+            SimplexDirection::Outgoing => self.upload.lock().unwrap(),
+        };
+        b.refill();
+        b.tokens = (b.tokens + bytes as f64).min(Bucket::capacity(b.rate));
+    }
+    fn new(p: &TrafficPolicy) -> Self {
+        Self {
+            enabled: AtomicBool::new(p.enabled),
+            download: Mutex::new(Bucket::new(p.download_mbps)),
+            upload: Mutex::new(Bucket::new(p.upload_mbps)),
+            changed: watch::channel(0).0,
+        }
+    }
+    fn update(&self, p: &TrafficPolicy) {
+        self.download.lock().unwrap().update(p.download_mbps);
+        self.upload.lock().unwrap().update(p.upload_mbps);
+        self.enabled.store(p.enabled, Ordering::Release);
+        self.changed.send_modify(|n| *n = n.wrapping_add(1));
+    }
+    pub(crate) async fn acquire(
+        &self,
+        direction: SimplexDirection,
+        mut bytes: usize,
+    ) -> io::Result<()> {
+        let mut changed = self.changed.subscribe();
+        while bytes > 0 {
+            if !self.enabled.load(Ordering::Acquire) {
+                return Err(io::ErrorKind::PermissionDenied.into());
+            }
+            changed.borrow_and_update();
+            let delay = {
+                let mut b = match direction {
+                    SimplexDirection::Incoming => self.download.lock().unwrap(),
+                    SimplexDirection::Outgoing => self.upload.lock().unwrap(),
+                };
+                b.refill();
+                if b.rate == 0 {
+                    return Ok(());
+                }
+                let part = bytes.min(Bucket::capacity(b.rate) as usize);
+                if b.tokens >= part as f64 {
+                    b.tokens -= part as f64;
+                    bytes -= part;
+                    None
+                } else {
+                    Some(Duration::from_secs_f64(
+                        ((part as f64 - b.tokens) / b.rate as f64).max(0.000001),
+                    ))
+                }
+            };
+            if let Some(delay) = delay {
+                tokio::select! { _ = tokio::time::sleep(delay) => {}, _ = changed.changed() => {} }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Default)]
+pub struct TrafficControl {
+    policies: RwLock<Option<HashMap<String, Arc<UserControl>>>>,
+    sessions: Mutex<HashMap<u64, Weak<ManagedSession>>>,
+    next: AtomicU64,
+}
+pub(crate) struct ManagedSession {
+    id: u64,
+    owner: Mutex<Option<String>>,
+    cancel: watch::Sender<bool>,
+    control: Weak<TrafficControl>,
+}
+impl Drop for ManagedSession {
+    fn drop(&mut self) {
+        if let Some(c) = self.control.upgrade() {
+            c.sessions.lock().unwrap().remove(&self.id);
+        }
+    }
+}
+impl ManagedSession {
+    pub(crate) fn close(&self) {
+        self.cancel.send_replace(true);
+    }
+    pub(crate) async fn cancelled(&self) {
+        let mut rx = self.cancel.subscribe();
+        while !*rx.borrow_and_update() {
+            if rx.changed().await.is_err() {
+                break;
+            }
+        }
+    }
+    pub(crate) fn bind(&self, username: &str) -> io::Result<Option<Arc<UserControl>>> {
+        let control = self
+            .control
+            .upgrade()
+            .ok_or(io::ErrorKind::ConnectionAborted)?;
+        let policies = control.policies.read().unwrap();
+        let Some(policies) = policies.as_ref() else {
+            return Ok(None);
+        };
+        let user = policies
+            .get(username)
+            .filter(|u| u.enabled.load(Ordering::Acquire))
+            .cloned()
+            .ok_or(io::ErrorKind::PermissionDenied)?;
+        let mut owner = self.owner.lock().unwrap();
+        if *self.cancel.borrow() || owner.as_ref().is_some_and(|u| u != username) {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        *owner = Some(username.into());
+        Ok(Some(user))
+    }
+}
+impl TrafficControl {
+    pub fn replace(&self, replacement: &[TrafficPolicy]) {
+        let mut policies = self.policies.write().unwrap();
+        let old = policies.get_or_insert_with(HashMap::new);
+        let mut next = HashMap::new();
+        for p in replacement {
+            let user = old
+                .get(&p.username)
+                .cloned()
+                .unwrap_or_else(|| Arc::new(UserControl::new(p)));
+            user.update(p);
+            next.insert(p.username.clone(), user);
+        }
+        for (name, user) in old.iter() {
+            if !next.contains_key(name) {
+                user.enabled.store(false, Ordering::Release);
+                user.changed.send_modify(|n| *n = n.wrapping_add(1));
+            }
+        }
+        *old = next;
+        // Keep the policy lock until affected transports are marked. New binds cannot race removal.
+        let sessions: Vec<_> = self
+            .sessions
+            .lock()
+            .unwrap()
+            .values()
+            .filter_map(Weak::upgrade)
+            .collect();
+        for session in sessions {
+            if let Some(name) = session.owner.lock().unwrap().as_ref() {
+                if !old
+                    .get(name)
+                    .is_some_and(|u| u.enabled.load(Ordering::Acquire))
+                {
+                    session.cancel.send_replace(true);
+                }
+            }
+        }
+    }
+    pub fn disconnect(&self, username: &str) -> usize {
+        let sessions: Vec<_> = self
+            .sessions
+            .lock()
+            .unwrap()
+            .values()
+            .filter_map(Weak::upgrade)
+            .collect();
+        let mut count = 0;
+        for session in sessions {
+            if session.owner.lock().unwrap().as_deref() == Some(username)
+                && !*session.cancel.borrow()
+            {
+                session.cancel.send_replace(true);
+                count += 1;
+            }
+        }
+        count
+    }
+    pub(crate) fn session(self: &Arc<Self>) -> Arc<ManagedSession> {
+        let id = self.next.fetch_add(1, Ordering::Relaxed);
+        let session = Arc::new(ManagedSession {
+            id,
+            owner: Mutex::new(None),
+            cancel: watch::channel(false).0,
+            control: Arc::downgrade(self),
+        });
+        self.sessions
+            .lock()
+            .unwrap()
+            .insert(id, Arc::downgrade(&session));
+        session
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn policy(name: &str) -> TrafficPolicy {
+        TrafficPolicy {
+            username: name.into(),
+            enabled: true,
+            download_mbps: 1,
+            upload_mbps: 1,
+        }
+    }
+    #[tokio::test(start_paused = true)]
+    async fn parallel_streams_share_bucket_and_directions_are_independent() {
+        let c = Arc::new(TrafficControl::default());
+        c.replace(&[policy("alice"), policy("bob")]);
+        let a = c.session();
+        let user = a.bind("alice").unwrap().unwrap();
+        user.acquire(SimplexDirection::Incoming, 65536)
+            .await
+            .unwrap();
+        let started = Instant::now();
+        let (x, y) = tokio::join!(
+            user.acquire(SimplexDirection::Incoming, 62500),
+            user.acquire(SimplexDirection::Incoming, 62500)
+        );
+        x.unwrap();
+        y.unwrap();
+        assert!(Instant::now().duration_since(started) >= Duration::from_secs(1));
+        let started = Instant::now();
+        user.acquire(SimplexDirection::Outgoing, 65536)
+            .await
+            .unwrap();
+        assert_eq!(Instant::now(), started);
+        let b = c.session();
+        b.bind("bob")
+            .unwrap()
+            .unwrap()
+            .acquire(SimplexDirection::Incoming, 65536)
+            .await
+            .unwrap();
+        assert_eq!(Instant::now(), started);
+    }
+    #[tokio::test(start_paused = true)]
+    async fn changes_wake_waiters_and_do_not_reset_burst() {
+        let c = Arc::new(TrafficControl::default());
+        c.replace(&[policy("alice")]);
+        let session = c.session();
+        let user = session.bind("alice").unwrap().unwrap();
+        user.acquire(SimplexDirection::Incoming, 65536)
+            .await
+            .unwrap();
+        c.replace(&[policy("alice")]);
+        let start = Instant::now();
+        user.acquire(SimplexDirection::Incoming, 12500)
+            .await
+            .unwrap();
+        assert!(Instant::now().duration_since(start) >= Duration::from_millis(100));
+        let mut p = policy("alice");
+        p.download_mbps = 0;
+        let wait = user.acquire(SimplexDirection::Incoming, 1250000);
+        let update = async {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+            c.replace(&[p]);
+        };
+        let start = Instant::now();
+        let (r, _) = tokio::join!(wait, update);
+        r.unwrap();
+        assert_eq!(
+            Instant::now().duration_since(start),
+            Duration::from_millis(10)
+        );
+    }
+    #[tokio::test]
+    async fn kick_is_targeted_and_cancellation_cannot_be_missed() {
+        let c = Arc::new(TrafficControl::default());
+        c.replace(&[policy("alice"), policy("bob")]);
+        let a = c.session();
+        a.bind("alice").unwrap();
+        let b = c.session();
+        b.bind("bob").unwrap();
+        assert!(a.bind("bob").is_err());
+        assert_eq!(c.disconnect("alice"), 1);
+        assert_eq!(c.disconnect("alice"), 0);
+        tokio::time::timeout(Duration::from_millis(100), a.cancelled())
+            .await
+            .unwrap();
+        assert!(!*b.cancel.borrow());
+        let new = c.session();
+        assert!(new.bind("alice").is_ok());
+        c.replace(&[policy("bob")]);
+        assert!(*new.cancel.borrow());
+        assert!(!*b.cancel.borrow());
+    }
+}
