+++ b/lib/tests/managed.rs
@@ -0,0 +1,348 @@
+//! Actual TLS H2 and QUIC H3 traffic, not a standalone token-bucket simulation.
+use base64::{engine::general_purpose::STANDARD, Engine};
+use http::Request;
+use std::net::{Ipv4Addr, SocketAddr};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpListener;
+use trusttunnel::authentication::registry_based::{Client, RegistryBasedAuthenticator};
+use trusttunnel::core::Core;
+use trusttunnel::settings::{
+    Http2Settings, ListenProtocolSettings, QuicSettings, Settings, TlsHostInfo, TlsHostsSettings,
+};
+use trusttunnel::shutdown::Shutdown;
+use trusttunnel::traffic_control::TrafficPolicy;
+#[allow(dead_code)]
+mod common;
+
+async fn transfer(
+    h3: bool,
+    endpoint: SocketAddr,
+    target: SocketAddr,
+    username: &str,
+    upload: bool,
+) -> usize {
+    let auth = format!(
+        "Basic {}",
+        STANDARD.encode(format!("{}:test-password-123", username))
+    );
+    let req = Request::builder()
+        .method("CONNECT")
+        .uri(target.to_string())
+        .header("proxy-authorization", auth)
+        .body(hyper::Body::empty())
+        .unwrap();
+    if h3 {
+        let mut client = common::Http3Session::connect(&endpoint, "localhost", None).await;
+        client.send_request(req).await;
+        assert_eq!(
+            client
+                .recv_response_with_method(&http::Method::CONNECT)
+                .await
+                .status,
+            http::StatusCode::OK
+        );
+        if upload {
+            client
+                .send(common::make_stream_of_chunks(262144, None))
+                .await;
+            let mut ack = [0u8; 1];
+            assert_eq!(client.recv(&mut ack).await, 1);
+            assert_eq!(ack[0], 7);
+            return 262144;
+        }
+        let mut total = 0;
+        let mut buf = vec![0; 16384];
+        while total < 262144 {
+            let n = client.recv(&mut buf).await;
+            if n == 0 {
+                break;
+            };
+            total += n;
+        }
+        total
+    } else {
+        let tls = common::establish_tls_connection("localhost", &endpoint, Some(b"h2")).await;
+        let (mut client, connection) = hyper::client::conn::Builder::new()
+            .http2_only(true)
+            .handshake(tls)
+            .await
+            .unwrap();
+        let driver = tokio::spawn(async move {
+            let _ = connection.await;
+        });
+        let resp = client.send_request(req).await.unwrap();
+        assert_eq!(resp.status(), http::StatusCode::OK);
+        let mut io = hyper::upgrade::on(resp).await.unwrap();
+        if upload {
+            io.write_all(&vec![42u8; 262144]).await.unwrap();
+            let mut ack = [0u8; 1];
+            io.read_exact(&mut ack).await.unwrap();
+            assert_eq!(ack[0], 7);
+            driver.abort();
+            return 262144;
+        }
+        let mut buf = Vec::new();
+        while buf.len() < 262144 {
+            let mut chunk = vec![0; 16384];
+            let n = io.read(&mut chunk).await.unwrap();
+            if n == 0 {
+                break;
+            };
+            buf.extend_from_slice(&chunk[..n]);
+        }
+        driver.abort();
+        buf.len()
+    }
+}
+
+fn make_endpoint() -> (SocketAddr, common::File, Arc<Core>) {
+    let endpoint = common::make_endpoint_address();
+    let cert = common::make_cert_key_file();
+    let cert_path = cert.path.to_str().unwrap().to_string();
+    let settings = Settings::builder()
+        .listen_address(&endpoint)
+        .unwrap()
+        .allow_private_network_connections(true)
+        .listen_protocols(ListenProtocolSettings {
+            http1: None,
+            http2: Some(Http2Settings::builder().build()),
+            quic: Some(QuicSettings::builder().build()),
+        })
+        .clients(
+            ["alice", "bob"]
+                .iter()
+                .map(|name| Client {
+                    username: (*name).into(),
+                    password: "test-password-123".into(),
+                    max_http2_conns: None,
+                    max_http3_conns: None,
+                })
+                .collect(),
+        )
+        .build()
+        .unwrap();
+    let registry = Arc::new(RegistryBasedAuthenticator::new(settings.get_clients()));
+    let hosts = TlsHostsSettings::builder()
+        .main_hosts(vec![TlsHostInfo {
+            hostname: "localhost".into(),
+            cert_chain_path: cert_path.clone(),
+            private_key_path: cert_path,
+            allowed_sni: vec![],
+        }])
+        .build()
+        .unwrap();
+    let core = Arc::new(Core::new(settings, Some(registry), hosts, Shutdown::new()).unwrap());
+    core.traffic_control().replace(&[
+        TrafficPolicy {
+            username: "alice".into(),
+            enabled: true,
+            download_mbps: 2,
+            upload_mbps: 2,
+        },
+        TrafficPolicy {
+            username: "bob".into(),
+            enabled: true,
+            download_mbps: 0,
+            upload_mbps: 0,
+        },
+    ]);
+    (endpoint, cert, core)
+}
+
+async fn shared_rate_over_transport(h3: bool, upload: bool) {
+    let (endpoint, cert, core) = make_endpoint();
+    let server = tokio::spawn({
+        let core = core.clone();
+        async move { core.listen().await.unwrap() }
+    });
+    let origin = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+    let target = origin.local_addr().unwrap();
+    let origin_task = tokio::spawn(async move {
+        loop {
+            let (mut socket, _) = origin.accept().await.unwrap();
+            tokio::spawn(async move {
+                if upload {
+                    let mut bytes = vec![0u8; 262144];
+                    socket.read_exact(&mut bytes).await.unwrap();
+                    socket.write_all(&[7]).await.unwrap();
+                } else {
+                    let _ = socket.write_all(&vec![42u8; 262144]).await;
+                }
+            });
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    let start = tokio::time::Instant::now();
+    let work = async {
+        let alice = async {
+            let (a, b) = tokio::join!(
+                Box::pin(transfer(h3, endpoint, target, "alice", upload)),
+                Box::pin(transfer(h3, endpoint, target, "alice", upload))
+            );
+            assert_eq!((a, b), (262144, 262144));
+            start.elapsed()
+        };
+        let bob = async {
+            assert_eq!(
+                Box::pin(transfer(h3, endpoint, target, "bob", upload)).await,
+                262144
+            );
+            start.elapsed()
+        };
+        let (alice, bob) = tokio::join!(alice, bob);
+        assert!(
+            alice >= Duration::from_millis(1600),
+            "parallel connections multiplied the rate: {:?}",
+            alice
+        );
+        assert!(
+            bob < alice,
+            "unrelated user was throttled: bob={:?}, alice={:?}",
+            bob,
+            alice
+        );
+    };
+    tokio::time::timeout(Duration::from_secs(20), work)
+        .await
+        .unwrap();
+    server.abort();
+    origin_task.abort();
+    drop(cert);
+}
+#[tokio::test]
+async fn h2_parallel_connections_share_download_limit() {
+    Box::pin(shared_rate_over_transport(false, false)).await;
+}
+#[tokio::test]
+async fn h3_parallel_connections_share_download_limit() {
+    Box::pin(shared_rate_over_transport(true, false)).await;
+}
+#[tokio::test]
+async fn h2_parallel_connections_share_upload_limit() {
+    Box::pin(shared_rate_over_transport(false, true)).await;
+}
+#[tokio::test]
+async fn h3_parallel_connections_share_upload_limit() {
+    Box::pin(shared_rate_over_transport(true, true)).await;
+}
+
+fn connect_request(target: SocketAddr, username: &str) -> Request<hyper::Body> {
+    Request::builder()
+        .method("CONNECT")
+        .uri(target.to_string())
+        .header(
+            "proxy-authorization",
+            format!(
+                "Basic {}",
+                STANDARD.encode(format!("{}:test-password-123", username))
+            ),
+        )
+        .body(hyper::Body::empty())
+        .unwrap()
+}
+async fn h2_echo(
+    endpoint: SocketAddr,
+    target: SocketAddr,
+    name: &str,
+) -> (
+    hyper::client::conn::SendRequest<hyper::Body>,
+    hyper::upgrade::Upgraded,
+    tokio::task::JoinHandle<()>,
+) {
+    let tls = common::establish_tls_connection("localhost", &endpoint, Some(b"h2")).await;
+    let (mut client, connection) = hyper::client::conn::Builder::new()
+        .http2_only(true)
+        .handshake(tls)
+        .await
+        .unwrap();
+    let driver = tokio::spawn(async move {
+        let _ = connection.await;
+    });
+    let resp = client
+        .send_request(connect_request(target, name))
+        .await
+        .unwrap();
+    assert_eq!(resp.status(), http::StatusCode::OK);
+    (client, hyper::upgrade::on(resp).await.unwrap(), driver)
+}
+async fn targeted_kick(h3: bool) {
+    let (endpoint, cert, core) = make_endpoint();
+    let server = tokio::spawn({
+        let core = core.clone();
+        async move { core.listen().await.unwrap() }
+    });
+    let origin = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).await.unwrap();
+    let target = origin.local_addr().unwrap();
+    let origin_task = tokio::spawn(async move {
+        loop {
+            let (mut io, _) = origin.accept().await.unwrap();
+            tokio::spawn(async move {
+                let (mut reader, mut writer) = io.split();
+                let _ = tokio::io::copy(&mut reader, &mut writer).await;
+            });
+        }
+    });
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    let work = async {
+        if h3 {
+            let mut alice = common::Http3Session::connect(&endpoint, "localhost", None).await;
+            alice.send_request(connect_request(target, "alice")).await;
+            assert_eq!(
+                alice
+                    .recv_response_with_method(&http::Method::CONNECT)
+                    .await
+                    .status,
+                http::StatusCode::OK
+            );
+            let mut bob = common::Http3Session::connect(&endpoint, "localhost", None).await;
+            bob.send_request(connect_request(target, "bob")).await;
+            assert_eq!(
+                bob.recv_response_with_method(&http::Method::CONNECT)
+                    .await
+                    .status,
+                http::StatusCode::OK
+            );
+            assert_eq!(core.traffic_control().disconnect("alice"), 1);
+            tokio::time::timeout(Duration::from_secs(3), alice.wait_for_peer_close())
+                .await
+                .unwrap();
+            bob.send(futures::stream::iter([b"ok".as_slice()])).await;
+            let mut ack = [0u8; 2];
+            assert_eq!(bob.recv(&mut ack).await, 2);
+            assert_eq!(&ack, b"ok");
+        } else {
+            let (_alice_client, mut alice, mut driver) = h2_echo(endpoint, target, "alice").await;
+            let (_bob_client, mut bob, bob_driver) = h2_echo(endpoint, target, "bob").await;
+            assert_eq!(core.traffic_control().disconnect("alice"), 1);
+            let mut ack = [0u8; 2];
+            let closed = tokio::time::timeout(Duration::from_secs(3), alice.read(&mut ack))
+                .await
+                .unwrap();
+            assert!(closed.is_err() || closed.unwrap() == 0);
+            tokio::time::timeout(Duration::from_secs(3), &mut driver)
+                .await
+                .unwrap()
+                .unwrap();
+            bob.write_all(b"ok").await.unwrap();
+            bob.read_exact(&mut ack).await.unwrap();
+            assert_eq!(&ack, b"ok");
+            bob_driver.abort();
+        }
+    };
+    tokio::time::timeout(Duration::from_secs(10), Box::pin(work))
+        .await
+        .unwrap();
+    server.abort();
+    origin_task.abort();
+    drop(cert);
+}
+#[tokio::test]
+async fn h2_kick_closes_only_the_target_transport() {
+    Box::pin(targeted_kick(false)).await;
+}
+#[tokio::test]
+async fn h3_kick_closes_only_the_target_transport() {
+    Box::pin(targeted_kick(true)).await;
+}
