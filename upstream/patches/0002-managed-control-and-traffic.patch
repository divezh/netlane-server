diff --git a/endpoint/src/management.rs b/endpoint/src/management.rs
new file mode 100644
index 0000000..9374eb5
--- /dev/null
+++ b/endpoint/src/management.rs
@@ -0,0 +1,379 @@
+//! Version 1: one bounded JSON line per Unix connection. No public TCP listener.
+use serde::{Deserialize, Serialize};
+use std::collections::HashSet;
+use std::io;
+use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+use tokio::net::{UnixListener, UnixStream};
+use tokio::sync::{Mutex, Semaphore};
+use trusttunnel::authentication::registry_based::{Client, RegistryBasedAuthenticator};
+use trusttunnel::core::Core;
+use trusttunnel::traffic_control::TrafficPolicy;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ManagedUser {
+    pub id: String,
+    pub username: String,
+    pub password: String,
+    pub enabled: bool,
+    pub download_mbps: u32,
+    pub upload_mbps: u32,
+    pub revision: u64,
+    #[serde(default)]
+    pub max_http2_conns: Option<u32>,
+    #[serde(default)]
+    pub max_http3_conns: Option<u32>,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct State {
+    pub version: u32,
+    pub generation: u64,
+    pub users: Vec<ManagedUser>,
+}
+#[derive(Deserialize)]
+#[serde(tag = "op", rename_all = "snake_case", deny_unknown_fields)]
+enum Request {
+    Status,
+    Upsert {
+        expected_generation: u64,
+        user: ManagedUser,
+    },
+    Disconnect {
+        username: String,
+    },
+}
+pub struct Management {
+    state: Mutex<State>,
+    path: PathBuf,
+    core: Arc<Core>,
+    registry: Arc<RegistryBasedAuthenticator>,
+}
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid managed state")
+}
+fn secure_parent(path: &Path) -> io::Result<()> {
+    let parent = std::fs::metadata(path.parent().ok_or_else(invalid)?)?;
+    if !parent.is_dir() || parent.mode() & 0o027 != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "managed directory must be 0700 or 0750",
+        ));
+    }
+    Ok(())
+}
+impl State {
+    pub fn load_or_import(path: &Path, clients: &[Client]) -> io::Result<Self> {
+        if !path.is_absolute() {
+            return Err(invalid());
+        }
+        secure_parent(path)?;
+        let state = match std::fs::symlink_metadata(path) {
+            Ok(m) => {
+                if !m.is_file() || m.mode() & 0o077 != 0 || m.len() > 1048576 {
+                    return Err(invalid());
+                }
+                serde_json::from_slice(&std::fs::read(path)?).map_err(|_| invalid())?
+            }
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Self {
+                version: 1,
+                generation: 0,
+                users: clients
+                    .iter()
+                    .map(|c| ManagedUser {
+                        id: format!("legacy:{}", c.username),
+                        username: c.username.clone(),
+                        password: c.password.clone(),
+                        enabled: true,
+                        download_mbps: 0,
+                        upload_mbps: 0,
+                        revision: 1,
+                        max_http2_conns: c.max_http2_conns,
+                        max_http3_conns: c.max_http3_conns,
+                    })
+                    .collect(),
+            },
+            Err(e) => return Err(e),
+        };
+        state.validate()?;
+        Ok(state)
+    }
+    fn validate(&self) -> io::Result<()> {
+        if self.version != 1 || self.users.len() > 100 {
+            return Err(invalid());
+        }
+        let mut names = HashSet::new();
+        let mut ids = HashSet::new();
+        for u in &self.users {
+            if u.id.is_empty()
+                || u.id.len() > 128
+                || u.username.is_empty()
+                || u.username.len() > 64
+                || !u
+                    .username
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+                || u.password.is_empty()
+                || u.password.len() > 1024
+                || u.revision == 0
+                || u.download_mbps > 1000000
+                || u.upload_mbps > 1000000
+                || !names.insert(&u.username)
+                || !ids.insert(&u.id)
+            {
+                return Err(invalid());
+            }
+        }
+        Ok(())
+    }
+    fn clients(&self) -> Vec<Client> {
+        self.users
+            .iter()
+            .filter(|u| u.enabled)
+            .map(|u| Client {
+                username: u.username.clone(),
+                password: u.password.clone(),
+                max_http2_conns: u.max_http2_conns,
+                max_http3_conns: u.max_http3_conns,
+            })
+            .collect()
+    }
+    fn persist(&self, path: &Path) -> io::Result<()> {
+        secure_parent(path)?;
+        let parent = path.parent().ok_or_else(invalid)?;
+        let mut file = tempfile::NamedTempFile::new_in(parent)?;
+        serde_json::to_writer(file.as_file_mut(), self).map_err(|_| invalid())?;
+        file.as_file().sync_all()?;
+        file.persist(path).map_err(|e| e.error)?;
+        std::fs::File::open(parent)?.sync_all()
+    }
+    fn public(&self) -> serde_json::Value {
+        serde_json::json!({"version":1,"generation":self.generation,"capabilities":{"hot_reload":true,"disconnect_user":true,"speed_limits":true,"durable_quotas":false,"expiry":false},"users":self.users.iter().map(|u|serde_json::json!({"id":u.id,"username":u.username,"revision":u.revision,"enabled":u.enabled,"download_mbps":u.download_mbps,"upload_mbps":u.upload_mbps})).collect::<Vec<_>>()})
+    }
+}
+impl Management {
+    pub fn new(
+        state: State,
+        path: PathBuf,
+        core: Arc<Core>,
+        registry: Arc<RegistryBasedAuthenticator>,
+    ) -> io::Result<Arc<Self>> {
+        state.persist(&path)?;
+        let this = Arc::new(Self {
+            state: Mutex::new(state.clone()),
+            path,
+            core,
+            registry,
+        });
+        this.apply(&state)?;
+        Ok(this)
+    }
+    fn apply(&self, state: &State) -> io::Result<()> {
+        let clients = state.clients();
+        RegistryBasedAuthenticator::validate_clients(&clients)?;
+        self.core.traffic_control().replace(
+            &state
+                .users
+                .iter()
+                .map(|u| TrafficPolicy {
+                    username: u.username.clone(),
+                    enabled: u.enabled,
+                    download_mbps: u.download_mbps,
+                    upload_mbps: u.upload_mbps,
+                })
+                .collect::<Vec<_>>(),
+        );
+        self.core.reload_client_limits(&clients);
+        self.registry.replace_clients(&clients)
+    }
+    async fn handle(&self, request: Request) -> serde_json::Value {
+        let mut state = self.state.lock().await;
+        match request {
+            Request::Status => serde_json::json!({"ok":true,"state":state.public()}),
+            Request::Disconnect { username } => {
+                if !state.users.iter().any(|u| u.username == username) {
+                    return serde_json::json!({"ok":false,"error":"user_not_found"});
+                }
+                serde_json::json!({"ok":true,"disconnect_requested":self.core.traffic_control().disconnect(&username)})
+            }
+            Request::Upsert {
+                expected_generation,
+                user,
+            } => {
+                if expected_generation != state.generation {
+                    return serde_json::json!({"ok":false,"error":"generation_conflict"});
+                }
+                let mut next = state.clone();
+                if let Some(old) = next.users.iter_mut().find(|u| u.id == user.id) {
+                    if user.revision < old.revision || old.username != user.username {
+                        return serde_json::json!({"ok":false,"error":"revision_conflict"});
+                    }
+                    if user.revision == old.revision {
+                        if serde_json::to_vec(old).ok() != serde_json::to_vec(&user).ok() {
+                            return serde_json::json!({"ok":false,"error":"revision_conflict"});
+                        }
+                        // Retry the durability barrier after a lost/uncertain acknowledgement.
+                        if state.persist(&self.path).is_err() {
+                            return serde_json::json!({"ok":false,"error":"state_write_failed"});
+                        }
+                        return serde_json::json!({"ok":true,"state":state.public()});
+                    }
+                    *old = user;
+                } else {
+                    if user.password.len() < 12 {
+                        return serde_json::json!({"ok":false,"error":"invalid_user"});
+                    }
+                    next.users.push(user);
+                }
+                if next.validate().is_err() {
+                    return serde_json::json!({"ok":false,"error":"invalid_user"});
+                }
+                next.generation = match next.generation.checked_add(1) {
+                    Some(n) => n,
+                    None => return serde_json::json!({"ok":false,"error":"generation_exhausted"}),
+                };
+                let durable = next.persist(&self.path).is_ok();
+                if !durable {
+                    // A directory fsync can fail after rename. Align live state with the
+                    // committed file, but do not acknowledge durability to the caller.
+                    let committed =
+                        State::load_or_import(&self.path, &[])
+                            .ok()
+                            .is_some_and(|saved| {
+                                serde_json::to_vec(&saved).ok() == serde_json::to_vec(&next).ok()
+                            });
+                    if !committed {
+                        return serde_json::json!({"ok":false,"error":"state_write_failed"});
+                    }
+                }
+                let rotated: Vec<_> = state
+                    .users
+                    .iter()
+                    .filter(|old| {
+                        next.users
+                            .iter()
+                            .any(|u| u.id == old.id && u.password != old.password)
+                    })
+                    .map(|u| u.username.clone())
+                    .collect();
+                if self.apply(&next).is_err() {
+                    return serde_json::json!({"ok":false,"error":"apply_failed"});
+                }
+                for username in rotated {
+                    self.core.traffic_control().disconnect(&username);
+                }
+                *state = next;
+                if !durable {
+                    return serde_json::json!({"ok":false,"error":"state_durability_uncertain"});
+                }
+                serde_json::json!({"ok":true,"state":state.public()})
+            }
+        }
+    }
+    pub async fn serve(self: Arc<Self>, path: PathBuf) -> io::Result<()> {
+        if !path.is_absolute() {
+            return Err(invalid());
+        }
+        secure_parent(&path)?;
+        if let Ok(metadata) = std::fs::symlink_metadata(&path) {
+            if !metadata.file_type().is_socket()
+                || metadata.uid() != unsafe { nix::libc::geteuid() }
+            {
+                return Err(io::ErrorKind::AlreadyExists.into());
+            }
+            match UnixStream::connect(&path).await {
+                Err(e) if e.kind() == io::ErrorKind::ConnectionRefused => {
+                    std::fs::remove_file(&path)?
+                }
+                _ => return Err(io::ErrorKind::AddrInUse.into()),
+            }
+        }
+        let listener = UnixListener::bind(&path)?;
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o660))?;
+        let _guard = SocketGuard {
+            path: path.clone(),
+            inode: std::fs::symlink_metadata(&path)?.ino(),
+        };
+        let limit = Arc::new(Semaphore::new(16));
+        loop {
+            let permit = limit.clone().acquire_owned().await.map_err(|_| invalid())?;
+            let (stream, _) = listener.accept().await?;
+            let this = self.clone();
+            tokio::spawn(async move {
+                let _permit = permit;
+                let _ = tokio::time::timeout(Duration::from_secs(5), async move {
+                    let (read, mut write) = stream.into_split();
+                    let mut reader = BufReader::new(read).take(65537);
+                    let mut line = Vec::new();
+                    use tokio::io::AsyncReadExt;
+                    reader.read_until(b'\n', &mut line).await?;
+                    let response = if line.len() > 65536 || line.last() != Some(&b'\n') {
+                        serde_json::json!({"ok":false,"error":"invalid_request"})
+                    } else {
+                        match serde_json::from_slice(&line) {
+                            Ok(request) => this.handle(request).await,
+                            Err(_) => serde_json::json!({"ok":false,"error":"invalid_request"}),
+                        }
+                    };
+                    let mut bytes = serde_json::to_vec(&response).map_err(|_| invalid())?;
+                    bytes.push(b'\n');
+                    write.write_all(&bytes).await?;
+                    Ok::<_, io::Error>(())
+                })
+                .await;
+            });
+        }
+    }
+}
+struct SocketGuard {
+    path: PathBuf,
+    inode: u64,
+}
+impl Drop for SocketGuard {
+    fn drop(&mut self) {
+        if std::fs::symlink_metadata(&self.path)
+            .is_ok_and(|m| m.file_type().is_socket() && m.ino() == self.inode)
+        {
+            let _ = std::fs::remove_file(&self.path);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn saved_state_is_private_and_public_response_contains_no_secrets() {
+        let dir = tempfile::tempdir().unwrap();
+        std::fs::set_permissions(dir.path(), std::fs::Permissions::from_mode(0o700)).unwrap();
+        let path = dir.path().join("state.json");
+        let s = State {
+            version: 1,
+            generation: 3,
+            users: vec![ManagedUser {
+                id: "u1".into(),
+                username: "alice".into(),
+                password: "never-emit-this-password".into(),
+                enabled: true,
+                download_mbps: 2,
+                upload_mbps: 1,
+                revision: 2,
+                max_http2_conns: None,
+                max_http3_conns: None,
+            }],
+        };
+        s.validate().unwrap();
+        s.persist(&path).unwrap();
+        assert_eq!(std::fs::metadata(&path).unwrap().mode() & 0o777, 0o600);
+        assert!(!s.public().to_string().contains("never-emit"));
+        let loaded = State::load_or_import(&path, &[]).unwrap();
+        assert_eq!(loaded.generation, 3);
+        assert_eq!(loaded.users[0].download_mbps, 2);
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(State::load_or_import(&path, &[]).is_err());
+    }
+}
